ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
PORTAL_PASSWORD=change_this_internal_password
PORTAL_SESSION_SECRET=change_this_long_random_secret
GOOGLE_DRIVE_OUTPUT_FOLDER_ID=your_google_drive_folder_id
REPORT_INSIGHTS_PROVIDER=deterministic
REPORT_SOURCE_CURRENCY=USD
REPORT_CURRENCY=USD
REPORT_FX_POLICY=none
# Optional: preferred API path for MXN -> USD reports. Without it, the runner uses Banco de México's official public CSV export.
BANXICO_API_TOKEN=
REPORT_INSIGHTS_TIMEOUT_SECONDS=90
ANTHROPIC_INSIGHTS_MODEL=claude-sonnet-4-6
OPENAI_INSIGHTS_MODEL=gpt-5.4-mini
MASTER_CONTROL_SHEET_ID=your_master_control_sheet_id
CONTROL_SHEET_CLIENTS_SHEET=Clients
CONTROL_SHEET_RUNS_SHEET=Runs
ALLOW_FIRST_MONTH_BASELINE=false
INCLUDE_INACTIVE=false
CLOUD_RUN_PROJECT=your_gcp_project_id
CLOUD_RUN_REGION=us-central1
CLOUD_RUN_JOB_NAME=monthly-report-batch
CLOUD_RUN_JOB_CONTAINER_NAME=

# Cloud Run / production mode:
# Mount a service-account JSON and point this env var to the mounted path.
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/google/service-account.json

# Vercel/serverless mode:
# Paste the full service-account JSON as one environment variable.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Local OAuth mode:
# Keep GOOGLE_SERVICE_ACCOUNT_FILE unset and use local credentials.json/token files instead.

# Country benchmark reports: private server-side configuration and secrets.
BENCHMARK_CONFIG_DRIVE_ID=
# Local audit only; use a gitignored data/benchmarks/config.json.
BENCHMARK_CONFIG_FILE=
BENCHMARK_SESSION_SECRET=
BENCHMARK_PASSWORD_SEED=
META_ACCESS_TOKEN=
META_API_VERSION=
GOOGLE_ADS_API_VERSION=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
